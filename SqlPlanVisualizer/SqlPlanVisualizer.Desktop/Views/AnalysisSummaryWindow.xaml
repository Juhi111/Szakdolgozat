<Window x:Class="SqlPlanVisualizer.Desktop.Views.AnalysisSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elemzési összegzés"
        Width="1000"
        Height="750"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Window.Resources>
        <DataTemplate x:Key="FindingTemplate">
            <Border Background="White"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding Brief}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="Javaslat"
                               FontWeight="SemiBold"
                               Margin="0,12,0,4"/>

                    <TextBlock Text="{Binding NextStep}"
                               TextWrapping="Wrap"/>
                    <Expander Header="Mi alapján? – részletek és feltételek" Margin="0,8,0,0"><StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4"/>
                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,4"/>
                    </StackPanel></Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Elemzési összegzés"
                           FontSize="24"
                           FontWeight="SemiBold"/>

                <TextBlock Text="{Binding PairDescription}"
                           Foreground="#526078"
                           Margin="0,6,0,16"/>

                <TextBlock Text="{Binding PlanOriginText}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#526078"/>

                <WrapPanel>
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="Tervezési idő" Foreground="#526078"/>
                        <TextBlock Text="{Binding PlanningTimeText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Végrehajtási idő" Foreground="#526078"/>
                        <TextBlock Text="{Binding ExecutionTimeText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Expander Header="A tervlekéréskor elküldött SQL" Margin="0,0,0,12">
                    <TextBox Text="{Binding Result.Pair.Plan.Origin.SqlText, Mode=OneWay, TargetNullValue='Fájlból betöltött tervhez nincs igazolt SQL-forrás.'}"
                             IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto"/>
                </Expander>
                <TextBlock Text="A kiválasztott SQL-utasítás és terv önálló elemzési találatai."
                           TextWrapping="Wrap"
                           Foreground="#526078"
                           Margin="0,0,0,16"/>
                <Expander Header="Adatbázis alapján pontosított javaslatok" IsExpanded="False" Margin="0,0,0,16">
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding IndexAssessmentStatus}" TextWrapping="Wrap" Margin="0,6"/>
                        <TextBlock Text="{Binding IndexAssessment.SourceText}" TextWrapping="Wrap" Foreground="Gray" Margin="0,6"/>
                        <ItemsControl ItemsSource="{Binding IndexAssessment.Notices}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <ItemsControl ItemsSource="{Binding IndexAssessment.Items}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,5"><StackPanel>
                                <TextBlock Text="{Binding Table}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="{Binding Brief}" TextWrapping="Wrap"/>
                            </StackPanel></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Expander>

                <TextBlock Text="Mit érdemes átnézned?" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,8"/>
                <TextBlock Text="{Binding OverviewText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding Overview}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="White" Padding="14" CornerRadius="6" Margin="0,0,0,10"><StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Brief}" TextWrapping="Wrap" Margin="0,8"/>
                        <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" Foreground="#174E79"/>
                    </StackPanel></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Expander Header="Összekapcsolt megállapítások – részletek" Margin="0,8,0,16">
                    <ItemsControl ItemsSource="{Binding Result.CombinedFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>
                </Expander>

                <Expander Header="{Binding SqlFindingsHeader}"
                          IsExpanded="False"
                          Margin="0,0,0,16">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Ehhez az SQL-utasításhoz nem keletkezett találat."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result.SqlFindings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Result.SqlFindings}"
                                      ItemTemplate="{StaticResource FindingTemplate}"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{Binding PlanFindingsHeader}"
                          IsExpanded="False">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Ehhez a tervhez nem keletkezett találat."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result.PlanFindings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Result.PlanFindings}"
                                      ItemTemplate="{StaticResource FindingTemplate}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <!--Button Content="Felhasznált adatbázisadatok…" Click="OpenIndexes_Click" Padding="12,8" Margin="0,0,12,0"/-->
            <Button Content="SQL-javaslatok és összehasonlítás…" Click="OpenRewrites_Click" Padding="12,8" Margin="0,0,12,0"/>
            <Button Content="Mentés PDF-be"
                    MinWidth="130"
                    Padding="12,8"
                    Margin="0,0,12,0"
                    Command="{Binding SaveResultToPdf}"/>
            <Button Content="Bezárás"
                    Width="110"
                    Padding="12,8"
                    Click="CloseButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
