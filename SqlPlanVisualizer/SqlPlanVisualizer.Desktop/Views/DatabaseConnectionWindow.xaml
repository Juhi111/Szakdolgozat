<Window x:Class="SqlPlanVisualizer.Desktop.Views.DatabaseConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:SqlPlanVisualizer.Core.Enums;assembly=SqlPlanVisualizer.Core"
        Title="Adatbázis-kapcsolat"
        Width="560"
        Height="720"
        MinWidth="420"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="Adatbázis-kapcsolat"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Add meg a PostgreSQL-szerver kapcsolati adatait, majd teszteld a kapcsolatot."
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,0,0,20"/>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Mentett kapcsolatok" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          DisplayMemberPath="Name" IsEnabled="{Binding CanManageProfiles}"
                          SelectionChanged="Profiles_SelectionChanged" Padding="6" Margin="0,0,0,8"/>

                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Új profil" Click="NewProfile_Click" IsEnabled="{Binding CanManageProfiles}" Padding="12,6" Margin="0,0,8,8"/>
                    <Button Content="Kijelölt profil törlése" Click="DeleteProfile_Click" IsEnabled="{Binding CanDeleteProfile}" Padding="12,6" Margin="0,0,8,8"/>
                    <Button Content="Lista újratöltése" Click="ReloadProfiles_Click" Padding="12,6" Margin="0,0,8,8"/>
                </WrapPanel>

                <TextBlock Text="Kapcsolat neve (becenév)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8"/>
                <TextBlock Text="A Mentés frissíti a kijelölt profilt. Másik kapcsolat mentéséhez válaszd az Új profil gombot."
                           TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16"/>

                <TextBlock Text="Szerver"
                           Margin="0,0,0,4"/>

                <TextBox Text="{Binding Options.Host,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Padding="6"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Port"
                           Margin="0,0,0,4"/>

                <TextBox x:Name="PortTextBox"
                         Text="{Binding Options.Port,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnExceptions=True}"
                         Padding="6"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Adatbázis"
                           Margin="0,0,0,4"/>

                <TextBox Text="{Binding Options.Database,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Padding="6"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Felhasználónév"
                           Margin="0,0,0,4"/>

                <TextBox Text="{Binding Options.Username,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Padding="6"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Séma"
                           Margin="0,0,0,4"/>

                <TextBox Text="{Binding Options.Schema,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Padding="6"
                         Margin="0,0,0,4"/>

                <TextBlock Text="A kapcsolatteszt még nem ellenőrzi a séma létezését."
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Jelszó"
                           Margin="0,0,0,4"/>

                <PasswordBox x:Name="ConnectionPasswordBox"
                             Padding="6"
                             Margin="0,0,0,12"/>

                <TextBlock Text="Kapcsolat titkosítása"
                           Margin="0,0,0,4"/>

                <ComboBox SelectedValue="{Binding Options.TlsMode, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          Padding="6"
                          Margin="0,0,0,8">

                    <ComboBoxItem Content="TLS – teljes tanúsítvány-ellenőrzés"
                                  Tag="{x:Static enums:DatabaseTlsMode.VerifyFull}"/>

                    <ComboBoxItem Content="Titkosítás nélkül – helyi teszteléshez"
                                  Tag="{x:Static enums:DatabaseTlsMode.Disable}"/>
                </ComboBox>

                <TextBlock Text="A jelszót nem mentjük fájlba."
                           Foreground="Gray"
                           Margin="0,0,0,16"/>

                <WrapPanel Margin="0,8,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="Margin" Value="0,0,8,8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PortTextBox, Path=(Validation.HasError)}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Resources>

                    <Button Content="Profil mentése" Click="SaveProfile_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanManageProfiles}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="TestConnectionButton" Content="Kapcsolat tesztelése" Click="TestConnectionButton_Click"/>
                    <Button x:Name="UseConnectionButton" Content="Kapcsolat használata" Click="UseConnectionButton_Click"/>
                </WrapPanel>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>