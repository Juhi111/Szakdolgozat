<Window x:Class="SqlPlanVisualizer.Desktop.Views.AnalysisSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elemzési összegzés"
        Width="1000"
        Height="750"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Window.Resources>
        <HierarchicalDataTemplate x:Key="ComparisonPlanTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding NodeType}"/>
                <TextBlock Text="{Binding RelationName}" Foreground="Gray" Margin="8,0,0,0"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate x:Key="FindingTemplate">
            <Border Background="White"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding Description}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="Javaslat"
                               FontWeight="SemiBold"
                               Margin="0,12,0,4"/>

                    <TextBlock Text="{Binding Recommendation}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Elemzési összegzés"
                           FontSize="24"
                           FontWeight="SemiBold"/>

                <TextBlock Text="{Binding PairDescription}"
                           Foreground="#526078"
                           Margin="0,6,0,16"/>

                <TextBlock Text="{Binding PlanOriginText}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#526078"/>

                <WrapPanel>
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="Tervezési idő" Foreground="#526078"/>
                        <TextBlock Text="{Binding PlanningTimeText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Végrehajtási idő" Foreground="#526078"/>
                        <TextBlock Text="{Binding ExecutionTimeText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Expander Header="A tervlekéréskor elküldött SQL" Margin="0,0,0,12">
                    <TextBox Text="{Binding Result.Pair.Plan.Origin.SqlText, Mode=OneWay, TargetNullValue='Fájlból betöltött tervhez nincs igazolt SQL-forrás.'}"
                             IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto"/>
                </Expander>
                <TextBlock Text="A kiválasztott SQL-utasítás és terv önálló elemzési találatai."
                           TextWrapping="Wrap"
                           Foreground="#526078"
                           Margin="0,0,0,16"/>
                <TextBlock Text="Összekapcsolt megállapítások"
           FontSize="18"
           FontWeight="SemiBold"
           Margin="0,0,0,12"/>

                <TextBlock Text="Nem találtunk közvetlenül összekapcsolható megállapítást."
           TextWrapping="Wrap"
           Margin="0,0,0,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Result.CombinedFindings.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Result.CombinedFindings}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EFF6FF"
                    BorderBrush="#93C5FD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                                    <TextBlock Text="SQL-megfigyelés"
                               FontWeight="SemiBold"
                               Margin="0,12,0,4"/>
                                    <TextBlock Text="{Binding SqlObservation}" TextWrapping="Wrap"/>

                                    <TextBlock Text="Tervmegfigyelés"
                               FontWeight="SemiBold"
                               Margin="0,12,0,4"/>
                                    <TextBlock Text="{Binding PlanObservation}" TextWrapping="Wrap"/>

                                    <TextBlock Text="Értékelés"
                               FontWeight="SemiBold"
                               Margin="0,12,0,4"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>

                                    <TextBlock Text="Javaslat"
                               FontWeight="SemiBold"
                               Margin="0,12,0,4"/>
                                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="{Binding RewriteHeader}" IsExpanded="True" Margin="0,0,0,16">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding RewriteStatus}" TextWrapping="Wrap" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RewriteSuggestions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding RewriteSuggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding VerificationStatus}" Foreground="#92400E" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                            <TextBlock Text="Eredeti SQL" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                            <TextBox Text="{Binding OriginalSql, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Padding="8"/>
                                            <TextBlock Text="Javasolt SQL – kijelölhető és másolható" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                            <TextBox Text="{Binding SuggestedSql, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Padding="8"/>
                                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,12,0,8"/>
                                            <TextBlock Text="Alkalmazási feltételek" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Preconditions}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <Expander Header="Javaslat tervlekérése és összehasonlítása" IsExpanded="True" Margin="0,0,0,16">
                    <StackPanel DataContext="{Binding RewriteComparison}" Margin="0,10,0,0">
                        <StackPanel IsEnabled="{Binding CanSelect}">
                            <ComboBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding SuggestedSql}" TextTrimming="CharacterEllipsis" MaxWidth="700"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <WrapPanel>
                                <Button Content="Becsült terv lekérése" Command="{Binding EstimatedCommand}" IsEnabled="{Binding CanStart}" Padding="12,8" Margin="0,0,8,8"/>
                                <Button Content="Futtatás és mérés" Command="{Binding ActualCommand}" IsEnabled="{Binding CanStart}" Padding="12,8" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                        <Button Content="Lekérés megszakítása" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" HorizontalAlignment="Left" Padding="12,6"/>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <StackPanel DataContext="{Binding Comparison}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding EquivalenceStatus}" FontWeight="SemiBold" Foreground="#92400E" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TimingAssessment}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <TextBlock Text="Eredeti terv eredete" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Original.Pair.Plan.Origin.Description}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <TextBlock Text="Javasolt terv eredete" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SuggestedPlan.Origin.Description}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Metrics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Adat" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Eredeti" Binding="{Binding Original}" Width="*"/>
                                <DataGridTextColumn Header="Javasolt" Binding="{Binding Suggested}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Eredeti terv" FontWeight="SemiBold"/>
                                <TreeView ItemsSource="{Binding OriginalRoots}" ItemTemplate="{StaticResource ComparisonPlanTemplate}" MaxHeight="240"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Javasolt terv" FontWeight="SemiBold"/>
                                <TreeView ItemsSource="{Binding SuggestedRoots}" ItemTemplate="{StaticResource ComparisonPlanTemplate}" MaxHeight="240"/>
                            </StackPanel>
                        </Grid>
                        <Expander Header="A javaslat SQL-találatai" Margin="0,12,0,8">
                            <ItemsControl ItemsSource="{Binding Comparison.SqlFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>
                        </Expander>
                        <Expander Header="A javaslat tervtalálatai">
                            <ItemsControl ItemsSource="{Binding Comparison.PlanFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>
                        </Expander>
                    </StackPanel>
                </Expander>

                <Expander Header="{Binding SqlFindingsHeader}"
                          IsExpanded="True"
                          Margin="0,0,0,16">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Ehhez az SQL-utasításhoz nem keletkezett találat."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result.SqlFindings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Result.SqlFindings}"
                                      ItemTemplate="{StaticResource FindingTemplate}"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{Binding PlanFindingsHeader}"
                          IsExpanded="True">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Ehhez a tervhez nem keletkezett találat."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result.PlanFindings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Result.PlanFindings}"
                                      ItemTemplate="{StaticResource FindingTemplate}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Mentés PDF-be"
                    MinWidth="130"
                    Padding="12,8"
                    Margin="0,0,12,0"
                    Command="{Binding SaveResultToPdf}"/>
            <Button Content="Bezárás"
                    Width="110"
                    Padding="12,8"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
