<Window x:Class="SqlPlanVisualizer.Desktop.Views.IndexMetadataWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Indexek és kulcsok" Width="1000" Height="720" MinWidth="650" MinHeight="450" WindowStartupLocation="CenterOwner">
    <Window.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,3"/></Style></Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Indexek és kulcsok" FontSize="24" FontWeight="SemiBold"/>
            <WrapPanel><Button Content="Lekérés / frissítés" Command="{Binding LoadCommand}" Padding="14,8" Margin="0,8,8,8"/><Button Content="Megszakítás" Click="Cancel_Click" Padding="14,8" Margin="0,8"/></WrapPanel>
            <TextBlock Text="{Binding StatusMessage}"/><TextBlock Text="{Binding Report.SourceText}" Foreground="Gray"/>
            <ItemsControl ItemsSource="{Binding Report.Notices}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="DarkOrange"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <TabControl Margin="0,12,0,0">
            <TabItem Header="Megállapítások"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Report.Tables}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="12">
                <TextBlock Text="{Binding Metadata.DisplayName}" FontSize="18" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Observations}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
            <TabItem Header="Index- és kulcsleltár"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Report.Tables}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="12">
                <TextBlock Text="{Binding Metadata.DisplayName}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Indexek" FontWeight="Bold"/>
                <ItemsControl ItemsSource="{Binding Metadata.Indexes}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,6"><StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding StateText}"/>
                    <TextBlock Text="{Binding KeysText, StringFormat='Kulcsok: {0}'}"/><TextBlock Text="{Binding IncludedText, StringFormat='INCLUDE: {0}'}"/>
                    <TextBlock Text="{Binding Predicate, StringFormat='Feltétel: {0}'}"/>
                    <TextBox Text="{Binding Definition, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" BorderThickness="0"/>
                </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="PRIMARY KEY / UNIQUE megszorítások" FontWeight="Bold"/>
                <ItemsControl ItemsSource="{Binding Metadata.Keys}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Details}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
        </TabControl>
    </DockPanel>
</Window>
